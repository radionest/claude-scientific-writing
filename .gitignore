.venv/
__pycache__/
*.pyc
.pytest_cache/
.claude/worktrees/
.claude/settings.local.json

# Superpowers session artifacts (plans, specs, SDD briefs/reports/diffs)
.superpowers/
docs/superpowers/

# OpenSpec local spec store (Claude working memory, synced via doc-review gate)
/openspec

# Local zcode scratch (not the committed project layer: plans, runs, autopilot state)
.zcode/plans/
.zcode/workflow-runs/
.zcode/workflow-drafts/
.zcode/autopilot.json

# uv lockfile — local environment artifact, kept out of release commits
uv.lock

# Python packaging metadata from `pip install -e .`
*.egg-info/

# Behavioral eval reports (/eval-prose) — local A/B history, not part of the oracle
tests/eval/reports/

# Local owner-style state: the tune-pair index pointing at project packs (R8)
var/
